{
  "name": "@growth-desk/api",
  "version": "0.1.0",
  "private": true,
  "description": "Growth Desk HTTP API and job worker (Express 5, Drizzle, pg-boss).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --conditions=development --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/db/migrate.ts",
    "db:seed": "tsx --conditions=development src/db/seed/index.ts",
    "memory:backfill": "tsx --conditions=development src/scripts/memory-backfill.ts",
    "db:studio": "drizzle-kit studio",
    "storage:cors": "tsx --conditions=development src/scripts/storage-cors.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@growth-desk/contract": "0.1.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ipaddr.js": "^1.9.1",
    "luxon": "^3.7.2",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "nock": "^15.0.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
