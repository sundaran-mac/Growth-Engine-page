# Growth Desk environment.
# Copy to .env and fill what you need. Empty values are fine for local development:
# local infra uses Docker defaults, and a feature whose keys are empty is switched off.
# In production (NODE_ENV=production) every secret and every third-party key is required.

# ---------- App ----------
# development | test | production (default development)
NODE_ENV=
# API port (default 4000)
PORT=
# Allowed browser origins, comma separated (default http://localhost:5173,http://localhost:8080)
WEB_ORIGIN=
# Public URL of the API, used in links and OAuth callbacks (default http://localhost:4000)
PUBLIC_API_URL=
# Time zone for schedules such as the Monday 07:00 run (default Asia/Kolkata)
APP_TIMEZONE=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Number of reverse proxies in front of the API (default 0; Docker sets 1)
TRUST_PROXY=

# ---------- Database (PostgreSQL 16) ----------
# Used by docker compose for the postgres container (defaults growthdesk / growthdesk-dev / growth_desk)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port for the compose Postgres (default 5433)
POSTGRES_PORT=
# Used by `npm run dev`, migrations and seed on your machine
# (default postgres://growthdesk:growthdesk-dev@localhost:5433/growth_desk)
DATABASE_URL=
# Test database, wiped by the test run (default .../growth_desk_test on the same server)
DATABASE_URL_TEST=

# ---------- Secrets ----------
# At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# Session length in hours, sliding (default 168 = 7 days)
SESSION_TTL_HOURS=
# true | false. Secure cookie flag (default true only in production)
COOKIE_SECURE=
# 32 bytes as 64 hex characters, encrypts social tokens. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Password for every sample user created by `npm run db:seed` (default growthdesk-dev)
SEED_USER_PASSWORD=

# ---------- File storage ----------
# r2 | minio (default minio in development)
STORAGE_DRIVER=
# Bucket name for MinIO (default growth-desk)
STORAGE_BUCKET=
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# MinIO (local). Root user is also the access key (defaults growthdesk / growthdesk-dev-secret)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Server-side and browser-side MinIO URLs (default http://localhost:9000 for both)
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=

# ---------- Claude ----------
ANTHROPIC_API_KEY=
# Default claude-opus-5-5
ANTHROPIC_MODEL=
# Monthly token cap per product, input plus output (default 2000000)
CLAUDE_MONTHLY_TOKEN_CAP=

# ---------- Content memory embeddings (optional) ----------
# Voyage AI key for the "same meaning" repeat check (ADR 0009). Empty turns that layer off;
# the same-words and similar-words checks still run. https://dash.voyageai.com
VOYAGE_API_KEY=
# Embedding model (default voyage-4, 1024 numbers per text; the database column is 1024)
VOYAGE_MODEL=

# ---------- Social channels ----------
# Meta app for Instagram and Facebook
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Google app for YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn app (needs LinkedIn approval)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Base URL for OAuth callbacks (default PUBLIC_API_URL)
OAUTH_REDIRECT_BASE_URL=
# Domain for tracked links (default live.humini.app)
TRACKING_LINK_BASE=

# ---------- Other integrations ----------
# GitHub token with read access to product repos (kit refresh)
GITHUB_TOKEN=

# ---------- Studio hand-off links (optional, https only) ----------
# Where the Studio "Hand off to a tool" cards open. Empty uses the tool's public home page.
HANDOFF_FIGMA_URL=
HANDOFF_CAPCUT_URL=
HANDOFF_ADOBE_EXPRESS_URL=
# Internal reel studio has no public default; the card is hidden while this is empty.
HANDOFF_REEL_STUDIO_URL=

# ---------- Email notifications (optional) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Web (Vite) ----------
# API base URL for the browser (default /api/v1, proxied by Vite in dev and nginx in Docker)
VITE_API_BASE_URL=

# ---------- Docker ports (optional) ----------
API_PORT=
WEB_PORT=
MINIO_PORT=
MINIO_CONSOLE_PORT=

# ---------- Platform API versions (optional; check first, they change) ----------
# LinkedIn REST version header, format YYYYMM. Old versions stop working; keep it current.
LINKEDIN_API_VERSION=
# Meta Graph API version, for example v24.0.
META_GRAPH_VERSION=
# YouTube upload privacy: public, unlisted or private. Empty means public.
YOUTUBE_PRIVACY_STATUS=
